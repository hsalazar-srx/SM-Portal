<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- ASP.NET Core In-Process hosting -->
    <handlers>
      <add name="aspNetCore" path="*" verb="*"
           modules="AspNetCoreModuleV2"
           resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath=".\MovexPortal.API.exe"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

    <!--
      Windows Authentication configuration.
      "Enable Windows Authentication for the server" is required so that
      IISDefaults.AuthenticationScheme (registered in Program.cs) can resolve.
      Anonymous Authentication is disabled — all requests must be authenticated.
    -->
    <security>
      <authentication>
        <windowsAuthentication enabled="true" />
        <anonymousAuthentication enabled="false" />
      </authentication>
    </security>

  </system.webServer>
</configuration>
