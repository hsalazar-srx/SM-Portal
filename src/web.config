<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    inheritInChildApplications="false" scopes all settings to this application only,
    preventing child apps from inheriting the aspNetCore handler. This matches the
    standard output of 'dotnet publish' and avoids duplicate-entry errors when the
    handler is already registered at the IIS server level in applicationHost.config.
  -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- ASP.NET Core In-Process hosting -->
      <handlers>
        <!-- Remove any server-level aspNetCore handler before adding ours -->
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath=".\MovexPortal.API.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ASPNETCORE_APPL_PATH"   value="/api" />
          <!-- %APPL_PHYSICAL_PATH% is NOT expanded by the ANCM version on SRXWEBAPP1.
               Hardcode the deployment path. Update this if the IIS site root changes. -->
          <environmentVariable name="ASPNETCORE_CONTENTROOT" value="C:\inetpub\wwwroot\SM-Portal" />
          <environmentVariable name="SMPORTAL_SECRETS_PATH"
                               value="C:\ProgramData\Scanfil\SM-Portal\secrets.json" />
        </environmentVariables>
      </aspNetCore>

    </system.webServer>
  </location>
</configuration>
