{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Endpoints": {
    "RegistryPath": "config/endpoint-registry.json"
  },
  "Audit": {
    "LogPath": "./logs/audit-log.jsonl",
