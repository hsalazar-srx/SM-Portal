{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Endpoints": {
    "RegistryPath": "../config/endpoint-registry.json"
  },
  "Audit": {
    "LogPath": "./logs/audit-log.jsonl",
    "RetentionDays": {
      "CRITICAL": 2555,
      "HIGH": 1095,
      "MEDIUM": 365,
      "LOW": 90
    }
  },
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "Authentication": {
    "Schemes": "Negotiate"
  }
}
