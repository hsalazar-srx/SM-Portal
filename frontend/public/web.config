<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    inheritInChildApplications="false" prevents the /api sub-application from
    inheriting this site's anonymousAuthentication=true setting, which would
    override the Windows Authentication configured in the backend's own web.config.
  -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!--
        SPA fallback: rewrite all requests that are not physical files or the /api
        sub-application back to index.html so React Router handles client-side routing.
        Without this, refreshing any route other than / returns IIS 404.

        REQUIRES: IIS URL Rewrite Module 2.1 installed on the server.
        Download: https://www.iis.net/downloads/microsoft/url-rewrite

        If the module is NOT installed, IIS returns 500.19 on startup and the
        entire site fails to load. Install the module then redeploy this file,
        OR comment out this section as a temporary workaround (direct-link
        navigation to any React route other than / will return 404 until installed).
      -->
      <rewrite>
        <rules>
          <rule name="SPA-Fallback" stopProcessing="true">
            <match url=".*" />
            <conditions logicalGrouping="MatchAll">
              <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
              <add input="{REQUEST_URI}"      pattern="^/api"         negate="true" />
            </conditions>
            <action type="Rewrite" url="/index.html" />
          </rule>
        </rules>
      </rewrite>

    </system.webServer>
  </location>
</configuration>
